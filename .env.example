# Optional local settings. Copy to .env to use.
# Everything here has a sensible default — the app runs with no .env at all.

# TA_HOST=127.0.0.1
# TA_PORT=8000

# Default model: large-v3 (most accurate for Kazakh) | large-v3-turbo | medium | small | base
# TA_LOCAL_MODEL=large-v3

# Device and quantisation. "auto" picks from the VRAM found on the machine.
# TA_DEVICE=auto          # auto | cuda | cpu
# TA_COMPUTE_TYPE=auto    # auto | float16 | int8_float16 | int8 | float32

# TA_MAX_UPLOAD_MB=512
# TA_MODEL_DIR=./data/models
